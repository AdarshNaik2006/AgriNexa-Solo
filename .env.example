# AgriNexa-Solo Environment Configuration Example
# Copy this file to .env and adjust variables as needed for production or custom setups.

# Secret key used for signing session cookies (Change this in production!)
SECRET_KEY=agrinexa-solo-dev-secret-key-2026-secure

# SQLite Database connection URI (Defaults to backend/instance/agrinexa.db)
DATABASE_URL=sqlite:///backend/instance/agrinexa.db

# Server Host & Port
FLASK_ENV=development
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
